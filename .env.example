# Copy this file to .env. Never put secret values directly in this file.

# A fresh data volume needs a root-owned 0400/0600 file containing a Tailscale
# auth key. The key must assign exactly a dedicated gateway tag whose Tailnet
# policy grants Internet/Exit-Node use but no peers, services, or advertised
# subnets. Once tsnet state has enrolled successfully, restarts no longer use
# the key. Adding a client-selectable exit requires another unused enrollment
# key here, or a short-lived reusable tagged key for several additions. Each
# extra exit enrolls a separate gateway identity. Remove/revoke enrollment
# credentials when no further exits need to be added.
TS_AUTH_KEY_FILE=/absolute/path/to/tailscale-auth-key

# Optional: root-owned 0400/0600 Tailscale API/OAuth bearer-token file. This is
# required for the validated default-exit picker and adding client-selectable
# exits in the administration UI. It is not included in subscriptions.
TS_API_KEY_FILE=

# Root-owned 0400/0600 credential for the remotely managed Named Tunnel. Keep
# this file outside the repository and always deploy through deploy/docker/compose-up.sh,
# which rejects symbolic links and unsafe ownership, links, size, or mode.
CLOUDFLARE_TUNNEL_TOKEN_FILE=/absolute/path/to/cloudflare-tunnel-token

# The three public names must be distinct normalized DNS hostnames. Cloudflare
# maps them to http://127.0.0.1:8443, :8080, and :8081 inside the shared Docker
# network namespace. Cloudflare terminates public TLS.
VPN_PUBLIC_HOSTNAME=vpn.example.com
SUBSCRIPTION_PUBLIC_BASE_URL=https://sub.example.com
ADMIN_PUBLIC_HOSTNAME=admin.example.com

# Leave empty on first bootstrap to generate a high-entropy canonical path.
WS_PATH=

# This operator-controlled target is probed on TCP 443 through every configured
# Exit Node. It must not be any of the Cloudflare Tunnel public hostnames.
EGRESS_HEALTH_HOST=operator-controlled-health.example.com

# Initial default exit-node address/name. Extra exits are published in the
# administration UI and appear after users refresh their subscription.
EXIT_NODE=100.64.0.10

# Optional bootstrap setting.
NODE_NAME=vps-cloudflare

# One-way migrations are always opt-in. Leave both blank unless you have
# reviewed the matching migration preview and intend to approve that cutover.
MIGRATE_LEGACY=
MIGRATE_REALITY=
