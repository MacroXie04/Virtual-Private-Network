# Copy to .env, fill in the values, then deploy with docker compose
# Tailscale auth key (generate under Settings → Keys in the admin console; reusable recommended, key expiry disabled)
TS_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxx
# Exit Node address (100.x.x.x or tailnet machine name)
EXIT_NODE=100.x.x.x
# This host's public address (IP or domain, embedded in subscription links)
VPS_HOST=203.0.113.10
# REALITY camouflage domain (optional)
SERVER_NAME=www.microsoft.com
# Node name (optional)
NODE_NAME=vps-reality
# Tailscale API access token (optional, used by the Web UI to list Exit Nodes in a dropdown)
TS_API_KEY=
