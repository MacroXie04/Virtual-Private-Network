# Copy this file to .env. Never put secret values directly in this file.

# A fresh data volume needs a root-owned 0400/0600 file containing a Tailscale
# auth key. The key must assign exactly a dedicated gateway tag whose Tailnet
# policy grants Internet/Exit-Node use but no peers, services, or advertised
# subnets. Once tsnet state has enrolled successfully, restarts no longer use
# the key and this setting may be removed.
TS_AUTH_KEY_FILE=/absolute/path/to/tailscale-auth-key

# Optional: root-owned 0400/0600 Tailscale API/OAuth bearer-token file. This is
# required only for the validated exit-node picker in the administration UI.
TS_API_KEY_FILE=

# Initial exit-node address/name and public VLESS endpoint.
EXIT_NODE=100.64.0.10
VPS_HOST=vpn.example.com

# Required: choose an HTTPS origin you are authorized to use as the REALITY
# camouflage target. Replace this reserved placeholder before deployment.
SERVER_NAME=replace-with-an-authorized-origin.example

# Optional bootstrap setting.
NODE_NAME=vps-reality

# Optional externally visible HTTPS subscription base. Leave blank when
# subscriptions are consumed only through an SSH tunnel or are not published.
PUBLIC_BASE_URL=

# Browser administration requires a locally trusted HTTPS frontend on a
# dedicated, non-localhost DNS name. The example name is intentionally
# non-resolving until mapped to the frontend by the operator. Never browse the
# raw loopback HTTP backend or reuse this name for subscriptions.
ADMIN_ALLOWED_HOSTS=admin.vpn.invalid:8444
ADMIN_ALLOWED_ORIGINS=https://admin.vpn.invalid:8444
