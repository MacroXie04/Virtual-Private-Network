# 复制为 .env 并填写后使用 docker compose 部署
# Tailscale auth key（后台 Settings → Keys 生成，建议 reusable、关闭 key expiry）
TS_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxx
# Exit Node 地址（100.x.x.x 或 tailnet 机器名）
EXIT_NODE=100.x.x.x
# 本机公网地址（IP 或域名，写入订阅链接）
VPS_HOST=203.0.113.10
# REALITY 伪装域名（可选）
SERVER_NAME=www.microsoft.com
# 节点名称（可选）
NODE_NAME=vps-reality
# Tailscale API access token（可选，用于 Web UI 下拉列出 Exit Node）
TS_API_KEY=
