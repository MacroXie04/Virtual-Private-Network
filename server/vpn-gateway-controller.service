[Unit]
Description=VPN gateway privileged controller
Wants=network-online.target
After=network-online.target
Before=vpn-gateway-subscription.service vpn-gateway-admin.service
PartOf=vpn-gateway.target

[Service]
Type=notify
NotifyAccess=all
User=root
Group=root
UMask=0007
WorkingDirectory=/opt/vpn-gateway
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DATA_DIR=/var/lib/vpn-gateway
Environment=CONTROLLER_SOCKET=/run/vpn-gateway/controller.sock
Environment=SINGBOX_CONFIG=/var/lib/vpn-gateway/runtime/sing-box.json
Environment=SINGBOX_STATE_DIR=/var/lib/vpn-gateway/tailscale
Environment=SINGBOX_SERVICE=vpn-gateway-sing-box.service
Environment=SUPERVISE=0
Environment=NODE_PORT=443
Environment=SINGBOX_UID=11000
Environment=SINGBOX_GID=11000
Environment=SUB_UID=11001
Environment=SUB_GID=11001
Environment=ADMIN_UID=11002
Environment=ADMIN_GID=11002
EnvironmentFile=/etc/vpn-gateway/runtime.env
EnvironmentFile=/etc/vpn-gateway/controller.env
EnvironmentFile=-/etc/vpn-gateway/tailscale-api.env
RuntimeDirectory=vpn-gateway
RuntimeDirectoryMode=0751
ExecStartPre=/usr/bin/env node /opt/vpn-gateway/src/bootstrap.js
ExecStart=/usr/bin/env node /opt/vpn-gateway/src/controller-server.js
ExecStartPost=/usr/bin/systemctl --no-block start vpn-gateway-subscription.service vpn-gateway-admin.service
Restart=on-failure
RestartSec=2s
TimeoutStartSec=330s
TimeoutStopSec=330s
KillMode=mixed

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
ReadWritePaths=/var/lib/vpn-gateway /run/vpn-gateway

[Install]
WantedBy=vpn-gateway.target
