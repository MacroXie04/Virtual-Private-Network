[Unit]
Description=VPN gateway sing-box data plane
Wants=network-online.target
After=network-online.target
BindsTo=vpn-gateway-controller.service
PartOf=vpn-gateway.target

[Service]
Type=simple
User=vpn-runtime
Group=vpn-runtime
UMask=0077
WorkingDirectory=/var/lib/vpn-gateway
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=SINGBOX_CONFIG=/var/lib/vpn-gateway/runtime/sing-box.json
Environment=SINGBOX_STATE_DIR=/var/lib/vpn-gateway/tailscale
EnvironmentFile=/etc/vpn-gateway/runtime.env
ExecStart=/opt/vpn-gateway/bin/sing-box-wrapper
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=mixed
LimitNOFILE=1048576

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadOnlyPaths=/var/lib/vpn-gateway/runtime
ReadWritePaths=/var/lib/vpn-gateway/tailscale
